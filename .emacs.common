(defvar ctl-z-map (make-sparse-keymap) "Keymap for C-z commands.")
(define-key global-map "\C-z" ctl-z-map)
(define-key ctl-z-map "c" 'compile)
(define-key ctl-z-map "m" 'menu-bar-open)
(autoload 'vc-git-grep "vc-git" "Git Grep" t)
(define-key ctl-z-map "g" 'vc-git-grep)
(define-key ctl-z-map "=" 'compare-windows)

